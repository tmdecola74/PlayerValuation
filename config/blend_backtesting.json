        {"name": "regular_playing_time", "minimum_actual": 300, "minimum_projected": 0}
      ]
    },
    "pitcher": {
      "exposure": "IP",
      "metrics": ["W", "SV", "SO", "ERA", "WHIP"],
      "headline_cohort": "substantial_innings",
      "cohorts": [
        {"name": "all_matched", "minimum_actual": 0, "minimum_projected": 0},
        {"name": "substantial_innings", "minimum_actual": 40, "minimum_projected": 0},
        {"name": "closer_candidates", "minimum_actual": 0, "minimum_projected": 0, "projected_any_sv_minimum": 5, "metrics": ["SV"]}
      ]
    }
  }
